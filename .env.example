PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/authenticator_db
APP_URL=http://localhost:3000

# Web Push VAPID Keys (Generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@example.com

# AES-256-GCM 32-byte key (64 hex characters) for TOTP secret encryption at rest
AES_SECRET_KEY=generate_with_node_crypto_randomBytes_32_hex

# Session / Token signing secret
SESSION_SECRET=generate_with_node_crypto_randomBytes_32_hex

# Super Admin Seed Credentials
SUPER_ADMIN_EMAIL=iamabdullahzubair@gmail.com
SUPER_ADMIN_PASSWORD=Admin123!Secure

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
LOCKOUT_MINUTES=15

