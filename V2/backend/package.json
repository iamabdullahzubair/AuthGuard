  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "bullmq": "^5.56.5",
    "argon2": "^0.45.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.1",
    "pg": "^8.13.3",
    "undici": "^6.21.1",
    "zod": "^3.24.2"
  }
