NODE_ENV=development
PORT=3100
# Create a dedicated v2 database. Never point this at the v1 database.
V2_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/authenticator_v2
V2_TRUST_PROXY_HOPS=0
V2_SESSION_TTL_DAYS=7
V2_LOGIN_WINDOW_SECONDS=900
V2_LOGIN_MAX_ATTEMPTS=10
V2_LOGIN_IP_MAX_ATTEMPTS=60
V2_REGISTER_MAX_ATTEMPTS=10
V2_SUPER_ADMIN_EMAIL=
V2_SUPER_ADMIN_PASSWORD=
# Redis can run on a separate host; use rediss:// when TLS is required.
V2_REDIS_URL=redis://localhost:6379
V2_WEBHOOK_WORKER_CONCURRENCY=5
# Generate a dedicated key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
V2_ENCRYPTION_KEY=
